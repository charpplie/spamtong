{
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "paths": {
      "comx":  ["./src/public/comx.ts"],
      "utils": ["./src/public/util.ts"],
      "models/*": ["./src/models/*"],
    },
    "strict": true,
    "module": "CommonJS",
    "target": "ES2022",
    "esModuleInterop": true,
  }
}