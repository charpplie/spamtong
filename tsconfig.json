{
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "paths": {
      "index": ["./src/index.ts"],
      "comx": ["./src/public/comx.ts"],
      "utils": ["./src/public/utils.ts"],
      "models/*": ["./src/models/*"]
    }
  }
}