{
  "ts-node": {
    "require": ["tsconfig-paths/register"],
  },
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "paths": {
      "public/*": ["./src/server/public/*"],
      "models/*": ["./src/client/models/*"],
    },
  }
}