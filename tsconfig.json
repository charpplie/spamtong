{
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "paths": {
      "public/*": ["./src/public/*"],
      "models/*": ["./src/models/*"],
    },
    "strict": true,
    "target": "ES2022",
    "module": "CommonJS",
    "alwaysStrict": true,
    "esModuleInterop": true,
  }
}