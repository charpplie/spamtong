{
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "paths": {
      "@/*":       ["./src/public/*"],
      "logger":    ["./src/index.ts"],
      "@models/*": ["./src/events/sys/models/*"],
    },
    "target": "ESNext",
    "module": "CommonJS",
    "esModuleInterop": true,
    "strict": true,
    "alwaysStrict": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],
}