{
  "ts-node": { "require": ["tsconfig-paths/register"] },
  "compilerOptions": {
    "paths": {
      "comx":     ["./src/public/comx.ts"],
      "models/*": ["./src/models/*"],
      "utils":    ["./src/public/utils.ts"],
      "index":    ["./src/index.ts"],
    },
    "target": "ESNext",
    "module": "CommonJS",
    "esModuleInterop": true,
    "strict": true,
    "alwaysStrict": true,
  }
}